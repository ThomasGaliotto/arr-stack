# ARR Media Stack - Environment Variables Template
# =============================================================================
# IMPORTANT: This is a TEMPLATE FILE only. Never commit secrets to Git!
# All sensitive values (VPN keys, API tokens) must be injected at runtime
# via the orchestrator's secret management system or Docker Compose secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# HOST CONFIGURATION
# -----------------------------------------------------------------------------

# Host data directory for persistent storage (bind-mounted from host filesystem)
HOST_DATA_ROOT=/arr-data

# Host configuration root for service configs and volumes
HOST_CONFIG_ROOT=/srv/media-stack/config

# Linux user ID - must match UID of files in /data directories on host
HOST_UID=1000

# Linux group ID - must match GID of files in /data directories on host  
HOST_GID=1000

# System timezone (IANA database format)
HOST_TIMEZONE=Europe/Brussels

# -----------------------------------------------------------------------------
# VPN CONFIGURATION
# -----------------------------------------------------------------------------

# Gluetun VPN_SERVICE_PROVIDER value (see Gluetun's provider list)
VPN_PROVIDER=protonvpn

# Gluetun VPN_TYPE: wireguard or openvpn
VPN_TYPE=wireguard

# Gluetun SERVER_COUNTRIES (comma-separated English country names)
VPN_COUNTRY=Netherlands

# Gluetun VPN_PORT_FORWARDING: on or off (ProtonVPN supports it on P2P servers)
VPN_PORT_FORWARDING=off

# Gluetun FREE_ONLY: set to "on" with a free ProtonVPN account so that only
# free servers are tried (Plus servers silently refuse free accounts)
VPN_FREE_ONLY=off

# Gluetun image tag
GLUETUN_VERSION=v3

# Host port of the qBittorrent Web UI (published by the gluetun container)
QBITTORRENT_WEBUI_PORT=8080

# Host IP the web UIs are published on (0.0.0.0 = all interfaces)
HOST_BIND_IP=0.0.0.0

# WireGuard private key: NOT set here. It is read from the WIREGUARD_PRIVATE_KEY
# environment variable when running `docker compose up` (GitHub secret in the
# deployment pipeline). Get it from the ProtonVPN dashboard: Downloads >
# WireGuard configuration, "PrivateKey" value of the generated file.

# -----------------------------------------------------------------------------
# MEDIA TYPES TO ENABLE/DISABLE
# -----------------------------------------------------------------------------

ENABLE_MOVIES=true
ENABLE_TV=true
ENABLE_MUSIC=true
ENABLE_BOOKS=false  # Optional: disable to save resources

# Subtitle language preferences (comma-separated)
SUBTITLE_LANGUAGES=en,es,it,fr,de,zh-cn,jp-ja,korean

# -----------------------------------------------------------------------------
# SERVICE VERSION PINNING (Use specific tags for reproducibility)
# -----------------------------------------------------------------------------

QBITTORRENT_VERSION=latest  # Consider pinning to a specific version like v4.6.x
SONARR_VERSION=latest      # Pin when major updates occur
RADARR_VERSION=latest
LIDARR_VERSION=latest
PROWLARR_VERSION=latest
BAZARR_VERSION=latest
JELLYSEERR_VERSION=latest
JELLYFIN_VERSION=latest

# Recyclarr for declarative quality profile management
RECYCLARR_VERSION=8

# -----------------------------------------------------------------------------
# SERVICE PORTS (Internal - not exposed publicly by default)
# =============================================================================
# Official default ports from Docker Hub images:
# Sonarr API/WebUI: 8989
# Radarr API/WebUI: 7878  
# Lidarr WebUI/API: 8686 (not 8684!)
# Prowlarr API: 9692
# Bazarr WebUI/API: 6767 (not 6750 - that's Sonarr's port!)
# Jellyseerr WebUI/API: 5055 (not 8097 which are Radarr/Sonarr ports)
QBITTORRENT_PORT=8091  # qBittorrent WebUI internal port only

# ARR service ports (internal, accessible via app_net):
SONARR_API_PORT=8989
RADARR_API_PORT=7878  
LIDARR_WEBUI_PORT=8686
PROWLARR_API_PORT=9692
BAZARR_WEBUI_PORT=6767

# Jellyseerr port (user-facing, can be exposed locally or via reverse proxy)
JELLYSEERR_WEBUI_PORT=5055

# Jellyfin port (media server UI - expose only if needed for local access)
JELLYFIN_UI_PORT=8096

# -----------------------------------------------------------------------------
# OPTIONAL SERVICES (Enable/disable via compose profiles, not here)
# -----------------------------------------------------------------------------

# Readarr configuration (optional - use profile instead):
READARR_ENABLED=false  # Enable with: docker compose --profile readarr up -d

# Tdarr for health checks and maintenance (optional):
TDARR_ENABLED=false    # Enable with appropriate profile

# Monitoring stack (Prometheus, Grafana, Loki) - all optional via profiles:
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false  
LOKI_ENABLED=false

# -----------------------------------------------------------------------------
# SECRET PLACEHOLDERS (NEVER COMMIT REAL VALUES!)
# =============================================================================
# These placeholders are for documentation only. The orchestrator must inject
# real secrets at runtime during deployment, not from this file.
# See: .gitignore - secrets/ directory is excluded from Git

# The WireGuard private key is never stored in a file: see the VPN section.

# Jellyseerr admin password (generate at runtime or use Docker secret)
# JELLYSEERR_ADMIN_PASSWORD=<GENERATE_AT_DEPLOYMENT>

# ARR service API keys where applicable (runtime injection only):
# SONARR_API_KEY=<INJECT_VIA_SECRET>
# RADARR_API_KEY=<INJECT_VIA_SECRET>
# etc.

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# =============================================================================

BACKUP_RETENTION_DAYS=30  # Keep backups for this many days before cleanup
BACKUP_COMPRESSION=gzip   # Compression algorithm (gzip, bzip2)
